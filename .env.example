OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

CV_PATH=C:\\Users\\Komputer\\Desktop\\Mateusz\\CV\\2026-01-27 - Mateusz Bursztynski Kostrzewa CV.pdf
KNOWLEDGE_PATH=data/knowledge.json
JOB_QUEUE_PATH=data/job_queue.jsonl
BROWSER_PROFILE_DIR=data/browser-profile
PROFILE_BOOTSTRAP_PATH=data/profile.bootstrap.json
PROFILE_PROMPT_ON_START=false
ALWAYS_APPLY_EXCEPT_OUTSIDE_POLAND=true
# Human-in-the-loop mode: when automation gets stuck, wait for manual action and resume.
COPILOT_MODE=true
# Disable terminal prompts (recommended for copilot browser-first workflow).
TERMINAL_INPUT_ENABLED=false
# How long copilot waits for manual browser intervention before timeout.
COPILOT_WAIT_TIMEOUT_SEC=240
# Poll cadence while waiting for manual intervention.
COPILOT_POLL_INTERVAL_MS=900
# If true, timed-out handoff skips current application; if false, marks as unavailable and continues logic.
COPILOT_AUTO_SKIP_ON_TIMEOUT=true
# Agentic fallback loop limits (LLM tool-driven recovery).
AGENTIC_FALLBACK_MAX_ITERATIONS=8
AGENTIC_TOOL_STEP_LIMIT=96
AGENTIC_TOOL_TIMEOUT_SEC=240
# Let LLM plan a short multi-step tool sequence when stuck.
AGENTIC_LLM_PLAN_ENABLED=true
AGENTIC_LLM_PLAN_MAX_STEPS=4
# Comma-separated labels/tokens blocked from LLM tool clicks for safety.
AGENTIC_BLOCKED_ACTION_TOKENS=discard,close application,withdraw,delete,remove,logout,log out,sign out,cancel application
# Reuse memorized playbooks only above confidence threshold and min uses.
AGENTIC_PLAYBOOK_CONFIDENCE_THRESHOLD=0.60
AGENTIC_PLAYBOOK_MIN_USES=1

# Discovery mode controls (used with --mode discovery_only / discovery_and_apply)
DISCOVERY_ENABLED=false
# Comma-separated include/exclude keywords.
DISCOVERY_KEYWORDS_INCLUDE=agentic ai,llm,python,seo automation
DISCOVERY_KEYWORDS_EXCLUDE=salesforce admin,on-site only
# Comma-separated preferred locations (fallback: profile city/country if empty).
DISCOVERY_LOCATIONS=Poland,Warsaw,Cracow
DISCOVERY_REMOTE_ONLY=false
DISCOVERY_DAYS_BACK=30
DISCOVERY_MAX_RESULTS=60
DISCOVERY_CACHE_PATH=data/job_discovery_cache.json
DISCOVERY_CACHE_TTL_MINUTES=90

# Queue retry policy for not_submitted jobs.
JOB_QUEUE_RETRY_LIMIT=3
JOB_QUEUE_RETRY_COOLDOWN_MINUTES=30

MAX_JOBS_PER_RUN=10
MIN_FIT_SCORE=50
AUTO_SUBMIT=true
APPLY_EXTERNAL_FORMS=true
DRY_RUN=false
SKIP_ALREADY_APPLIED=true
SLOW_MO_MS=150
AI_DISCLOSURE_ENABLED=true
AI_DISCLOSURE_TEXT=This application was submitted with assistance from an AI agent.

# Use your real Chrome profile/session instead of dedicated Playwright profile.
USE_SYSTEM_CHROME_PROFILE=false
SYSTEM_CHROME_USER_DATA_DIR=C:\\Users\\<YOU>\\AppData\\Local\\Google\\Chrome\\User Data
SYSTEM_CHROME_PROFILE_NAME=Default
# Optional channel override: chrome / msedge / chrome-beta / etc.
BROWSER_CHANNEL=
