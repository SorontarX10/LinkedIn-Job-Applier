OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

CV_PATH=C:\\Users\\Komputer\\Desktop\\Mateusz\\CV\\2026-01-27 - Mateusz Bursztynski Kostrzewa CV.pdf
KNOWLEDGE_PATH=data/knowledge.json
BROWSER_PROFILE_DIR=data/browser-profile
PROFILE_BOOTSTRAP_PATH=data/profile.bootstrap.json
PROFILE_PROMPT_ON_START=false
ALWAYS_APPLY_EXCEPT_OUTSIDE_POLAND=true
# Human-in-the-loop mode: when automation gets stuck, wait for manual action and resume.
COPILOT_MODE=true
# Disable terminal prompts (recommended for copilot browser-first workflow).
TERMINAL_INPUT_ENABLED=false
# How long copilot waits for manual browser intervention before timeout.
COPILOT_WAIT_TIMEOUT_SEC=240
# Poll cadence while waiting for manual intervention.
COPILOT_POLL_INTERVAL_MS=900
# If true, timed-out handoff skips current application; if false, marks as unavailable and continues logic.
COPILOT_AUTO_SKIP_ON_TIMEOUT=true

MAX_JOBS_PER_RUN=10
MIN_FIT_SCORE=50
AUTO_SUBMIT=true
APPLY_EXTERNAL_FORMS=true
DRY_RUN=false
SKIP_ALREADY_APPLIED=true
SLOW_MO_MS=150
AI_DISCLOSURE_ENABLED=true
AI_DISCLOSURE_TEXT=This application was submitted with assistance from an AI agent.

# Use your real Chrome profile/session instead of dedicated Playwright profile.
USE_SYSTEM_CHROME_PROFILE=false
SYSTEM_CHROME_USER_DATA_DIR=C:\\Users\\<YOU>\\AppData\\Local\\Google\\Chrome\\User Data
SYSTEM_CHROME_PROFILE_NAME=Default
# Optional channel override: chrome / msedge / chrome-beta / etc.
BROWSER_CHANNEL=
